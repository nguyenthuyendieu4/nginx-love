# Frontend Dockerfile for nginx-love React/Vite app
# Stage 1: Build the React application
FROM node:20-alpine AS builder

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Set working directory
WORKDIR /app

# Copy workspace configuration files
COPY ../pnpm-workspace.yaml ./
COPY ../package.json ./
COPY ../pnpm-lock.yaml ./
COPY ../turbo.json ./

# Copy web app package.json for dependency installation
COPY ../apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the entire web application source code
COPY ../apps/web ./apps/web

# Accept build args for environment variables
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build the Vite React application
RUN pnpm --filter @nginx-love/web build

# Stage 2: Serve with nginx + API proxy
FROM nginx:alpine

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy built frontend files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy panel nginx config (serves frontend + proxies /api to backend)
COPY docker/nginx-panel.conf /etc/nginx/conf.d/default.conf

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
